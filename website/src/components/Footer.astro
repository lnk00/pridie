---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const links = [
  { href: '#assistant', label: 'Assistant' },
  { href: '#product', label: 'Product' },
  { href: '#how-it-works', label: 'How it works' },
  { href: '#security', label: 'Security' },
  { href: '#faq', label: 'FAQ' },
];
---

<footer class="wrap pb-10">
  <div
    class="flex flex-col gap-8 border-t border-line pt-10 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <Logo />
      <p class="mt-3 text-sm text-ink-muted">Onboarding for tech teams.</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="mt-10 text-xs text-ink-muted">© {year} Pridie</p>
</footer>
