---
// Illustrative numbers from the overview example: local setup is the slow step.
const rows = [
  { task: 'Accept your Linear invitation', days: 0.2 },
  { task: 'Read the engineering handbook', days: 0.5 },
  { task: 'Set up the local environment', days: 2, blocked: true },
  { task: 'Ship a first small fix', days: 1.5 },
  { task: 'Meet your manager', days: 0.3 },
];
const max = Math.max(...rows.map((row) => row.days));
---

<div
  role="img"
  aria-label="Chart of average time per onboarding task, with illustrative data. Setting up the local environment takes the longest, about two days, and is where most new hires get blocked."
  class="rounded-3xl border border-line bg-white p-5 shadow-card sm:p-6"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-medium tracking-wide text-ink-muted uppercase">Average time per task</p>
      <p class="mt-1 text-sm text-ink-soft">Backend engineers</p>
    </div>
    <span class="rounded-full border border-line px-2.5 py-1 text-[0.6875rem] text-ink-muted">Illustrative data</span>
  </div>

  <ul class="mt-6 space-y-4">
    {
      rows.map((row) => (
        <li>
          <div class="flex items-baseline justify-between gap-3 text-sm">
            <span class:list={['truncate', row.blocked ? 'font-medium text-ink' : 'text-ink-soft']}>{row.task}</span>
            <span class:list={['shrink-0 tabular-nums', row.blocked ? 'font-medium text-sun-deep' : 'text-ink-muted']}>
              {row.days} {row.days === 1 ? 'day' : 'days'}
            </span>
          </div>
          <div class="mt-1.5 h-2.5 rounded-full bg-paper-deep">
            <div
              class:list={['bar h-full rounded-full', row.blocked ? 'bg-sun' : 'bg-ink/80']}
              style={`--w:${(row.days / max) * 100}%`}
            />
          </div>
          {row.blocked && (
            <p class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-sun-soft px-2.5 py-1 text-xs font-medium text-sun-deep">
              <span class="size-1.5 rounded-full bg-sun" />
              Most new hires get blocked here
            </p>
          )}
        </li>
      ))
    }
  </ul>
</div>
