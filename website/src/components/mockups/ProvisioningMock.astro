---
import Icon from '../ui/Icon.astro';
import ToolLogo, { type Tool } from '../ui/ToolLogo.astro';

// Order matters: Google Workspace creates the company email that Slack and Linear reuse.
const steps: { tool: Tool; name: string; detail: string; status: string; tone: string; icon: 'check' | 'mail' }[] = [
  { tool: 'google', name: 'Google Workspace', detail: 'Account and company email', status: 'Created', tone: 'bg-sage text-sage-ink', icon: 'check' },
  { tool: 'slack', name: 'Slack', detail: 'Member, with sam@acme.dev', status: 'Created', tone: 'bg-sage text-sage-ink', icon: 'check' },
  { tool: 'linear', name: 'Linear', detail: 'Invitation to sam@acme.dev', status: 'Sent', tone: 'bg-sky text-sky-ink', icon: 'mail' },
];
---

<div
  role="img"
  aria-label="Pridie creating Sam's accounts in order: Google Workspace account and company email sam@acme.dev, then the Slack member, then a Linear invitation to the same email."
  class="rounded-3xl border border-line bg-white p-5 shadow-card sm:p-6"
>
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="text-xs font-medium tracking-wide text-ink-muted uppercase">Accounts for Sam</p>
      <p class="mt-1 text-sm text-ink-soft">Backend engineer · Starts Monday</p>
    </div>
    <span class="shrink-0 rounded-full bg-sun-soft px-3 py-1 text-xs font-medium whitespace-nowrap text-sun-deep">3 of 3 done</span>
  </div>

  <ol class="mt-6">
    {
      steps.map((step, index) => (
        <li class="relative flex gap-4 pb-6 last:pb-0">
          {index < steps.length - 1 && (
            <span class="absolute top-10 bottom-0 left-[1.15rem] border-l-[1.5px] border-dashed border-line-strong" />
          )}
          <span class="relative grid size-9 shrink-0 place-items-center rounded-xl border border-line bg-white">
            <ToolLogo tool={step.tool} class="size-4.5" />
          </span>
          <div class="min-w-0 flex-1 pt-0.5">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-sm font-medium">
                  <span class="mr-1.5 text-ink-muted tabular-nums">{index + 1}.</span>
                  {step.name}
                </p>
                <p class="mt-0.5 text-xs text-ink-muted">{step.detail}</p>
              </div>
              <span class:list={['inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-1 text-xs font-medium', step.tone]}>
                <Icon name={step.icon} class="size-3.5" strokeWidth={2.5} />
                {step.status}
              </span>
            </div>
            {index === 0 && (
              <p class="mt-3 inline-flex items-center gap-2 rounded-lg border border-sun/25 bg-sun-soft/60 px-2.5 py-1.5 font-mono text-xs text-sun-deep">
                <Icon name="mail" class="size-3.5" />
                sam@acme.dev
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4 text-xs text-ink-muted">
    <span class="basis-full">Connected once by your admin</span>
    {
      steps.map((step) => (
        <span class="inline-flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-sage-ink/70" />
          {step.name}
        </span>
      ))
    }
  </div>
</div>
